import { LineEdit, ScrollView } from "std-widgets.slint";
import "./DMSans.ttf";

component NumberInput {
    in-out property <int> value;
    in-out property <string> text: "0";
    in property <int> minimum;
    in property <int> maximum;
    in property <string> unit: "";
    in property <bool> is-dark-theme;
    in property <bool> enabled: true;
    in property <bool> center-text: false;
    in property <length> font-size: 12px;
    in property <int> font-weight: 600;
    callback value-changed;
    in property <brush> background: is-dark-theme ? #1a1a1a : #ffffff;

    fs := FocusScope {
        width: 0px;
        height: 0px;
    }

    min-width: 0px;
    min-height: 30px;
    preferred-height: 30px;
    max-height: 30px;

    Rectangle {
        background: root.background;

        touch := TouchArea {
            enabled: root.enabled;
            width: 100%;
            height: 100%;
            clicked => { ti.focus(); }
            scroll-event(event) => {
                if event.delta_y > 0 {
                    root.value = Math.min(root.maximum, Math.max(root.minimum, root.value + 1));
                } else {
                    root.value = Math.min(root.maximum, Math.max(root.minimum, root.value - 1));
                }
                root.text = root.value;
                root.value-changed();
                accept
            }
        }

        HorizontalLayout {
            spacing: 0px;
            padding-left: 6px;
            padding-right: 6px;

            if (center-text) : Rectangle { horizontal-stretch: 1; }

            HorizontalLayout { spacing: 0px; horizontal-stretch: center-text ? 0 : 1;
                ti := TextInput {
                    enabled: root.enabled;
                    text <=> root.text;
                    input-type: number;
                    horizontal-alignment: center-text ? center : right;
                    horizontal-stretch: center-text ? 0 : 1;
                    vertical-alignment: center;
                    font-size: root.font-size;
                    font-weight: root.font-weight;
                    color: root.enabled
                        ? (is-dark-theme ? rgba(251,254,254,0.9) : #000000)
                        : (is-dark-theme ? rgba(251,254,254,0.4) : rgba(0,0,0,0.35));
                    min-width: 0px;
                    edited => { root.value-changed(); }
                    accepted => { fs.focus(); }
                }

                Text {
                    text: root.unit;
                    vertical-alignment: center;
                    font-size: max(11px, root.font-size - 1px);
                    color: root.enabled
                        ? (is-dark-theme ? rgba(251,254,254,0.5) : rgba(0,0,0,0.5))
                        : (is-dark-theme ? rgba(251,254,254,0.3) : rgba(0,0,0,0.3));
                }
            }

            if (center-text) : Rectangle { horizontal-stretch: 1; }
        }
    }
}

component FlatComboBox {
    in-out property <int> current-index;
    in property <[string]> model;
    in property <bool> is-dark-theme;
    in property <length> font-size: 12px;
    in property <int> font-weight: 600;
    in property <bool> bordered: false;
    callback selected(int);

    preferred-height: 30px;
    max-height: 30px;

    Rectangle {
        border-radius: root.bordered ? 6px : 0px;
        border-width: root.bordered ? 1px : 0px;
        border-color: root.bordered ? (is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18)) : transparent;
        background: transparent;

        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px;
            Text {
                text: model[current-index];
                vertical-alignment: center;
                font-size: root.font-size;
                font-weight: root.font-weight;
                color: is-dark-theme ? rgba(251,254,254,0.9) : #000000;
                horizontal-stretch: 1;
            }
            Text {
                text: "ᐯ";
                vertical-alignment: center;
                font-size: max(12px, root.font-size + 1px);
                font-weight: root.font-weight + 100;
                color: is-dark-theme ? rgba(251,254,254,0.8) : rgba(0,0,0,0.7);
            }
        }

        touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { popup.show(); }
            scroll-event(event) => {
                if event.delta_y > 0 {
                    current-index = Math.min(model.length - 1, current-index + 1);
                } else {
                    current-index = Math.max(0, current-index - 1);
                }
                accept
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: parent.height + 2px;
        Rectangle {
            min-width: touch.width;
            background: is-dark-theme ? #2e2e2e : #e8e8e8;
            border-radius: 6px;
            border-width: 1px;
            border-color: is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18);
            VerticalLayout { spacing: 0px;
                for item[idx] in model : Rectangle {
                    horizontal-stretch: 0;
                    min-height: 30px;
                    border-top-left-radius: idx == 0 ? 6px : 0px;
                    border-top-right-radius: idx == 0 ? 6px : 0px;
                    border-bottom-left-radius: idx == model.length - 1 ? 6px : 0px;
                    border-bottom-right-radius: idx == model.length - 1 ? 6px : 0px;
                    background: (idx == current-index || option-touch.has-hover) ? (is-dark-theme ? #3f3f3f : #d2d2d2) : transparent;
                    HorizontalLayout { padding-left: 8px; padding-right: 8px;
                        Text {
                            horizontal-stretch: 0;
                            text: item;
                            vertical-alignment: center;
                            font-size: root.font-size;
                            font-weight: root.font-weight;
                            color: is-dark-theme ? rgba(251,254,254,0.9) : #000000;
                        }
                    }
                    option-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { current-index = idx; root.selected(idx); popup.close(); }
                    }
                }
            }
        }
    }
}

component ControlBox {
    in property <bool> is-dark-theme;

    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18);
        background: is-dark-theme ? #1a1a1a : #ffffff;
        min-height: 30px;
        max-height: 30px;
        HorizontalLayout {
            spacing: 0px;
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 1px;
            padding-bottom: 1px;
            @children
        }
    }
}

component VDivider {
    in property <bool> is-dark-theme;
    Rectangle {
        width: 1px;
        min-height: 24px;
        background: is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18);
    }
}

component BrandCheckBox {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> is-dark-theme;

    width: 18px;
    preferred-height: 18px;
    min-height: 18px;

    Rectangle {
        width: 18px;
        height: 18px;
        y: Math.max(0px, (parent.height - 18px) / 2);
        border-radius: 4px;
        border-width: 1px;
        border-color: !root.enabled
            ? (is-dark-theme ? rgba(251,254,254,0.2) : rgba(0,0,0,0.2))
            : root.checked
                ? #19c233
                : (is-dark-theme ? rgba(251,254,254,0.4) : rgba(0,0,0,0.45));
        background: root.enabled && root.checked
            ? rgba(25,194,51,0.18)
            : (is-dark-theme ? rgba(251,254,254,0.06) : rgba(0,0,0,0.05));
        animate border-color { duration: 100ms; }
        animate background { duration: 100ms; }

        Path {
            width: 12px;
            height: 12px;
            x: (parent.width - 12px) / 2;
            y: (parent.height - 12px) / 2;
            stroke: root.enabled && root.checked ? #19c233 : transparent;
            stroke-width: 2px;
            commands: "M 1.5 6.5 L 5 10 L 10.5 2.5";
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        width: 18px;
        height: 100%;
        clicked => { root.checked = !root.checked; }
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "QuietAutoClicker";
    icon: @image-url("icons/QAC_Logo_256.png");
    width: 370px;
    always-on-top: true;
    default-font-family: "DM Sans";

    in-out property <bool> is-active;
    in-out property <bool> is-dark-theme: true;
    in-out property <int> rate-input-mode: 0;
    in-out property <int> click-speed: 25;
    in-out property <string> click-speed-text: "25";
    in-out property <int> click-interval: 0;
    in-out property <int> duration-hours: 0;
    in-out property <string> duration-hours-text: "0";
    in-out property <int> duration-minutes: 0;
    in-out property <string> duration-minutes-text: "0";
    in-out property <int> duration-seconds: 0;
    in-out property <string> duration-seconds-text: "0";
    in-out property <int> duration-milliseconds: 40;
    in-out property <string> duration-milliseconds-text: "40";
    in-out property <int> mouse-button: 0;
    in-out property <int> input-type: 0;
    in-out property <int> activation-mode: 0;
    in-out property <bool> random-enabled;
    in-out property <int> random-variation: 35;
    in-out property <string> random-variation-text: "35";
    in-out property <bool> double-click;
    in-out property <bool> limit-time-enabled;
    in-out property <int> limit-time-sec: 60;
    in-out property <string> limit-time-sec-text: "60";
    in-out property <string> click-key: "A";
    in-out property <bool> capturing-click-key;
    in-out property <string> hotkey: "F6";
    in-out property <bool> is-capturing-hotkey;
    in-out property <bool> hotkey-editable: true;
    in-out property <string> sequence-hotkey: "F7";
    in-out property <bool> is-capturing-sequence-hotkey;
    in-out property <bool> sequence-hotkey-editable: true;
    in-out property <bool> is-always-on-top: true;
    in-out property <bool> advanced-mode;
    in-out property <[int]> sequence-points-x: [];
    in-out property <[int]> sequence-points-y: [];
    in-out property <[int]> sequence-points-clicks: [];
    in-out property <int> sequence-points-count: 0;
    in-out property <bool> sequence-loop: true;
    in-out property <bool> sequence-smooth;
    in-out property <int> sequence-smooth-ms: 80;
    in-out property <string> sequence-smooth-ms-text: "80";
    in-out property <bool> sequence-enabled;
    in-out property <string> sequence-capture-hint: "";
    in-out property <bool> xwayland-ok: true;
    in-out property <bool> show-xwayland-status: false;
    in-out property <int> drag-idx: -1;
    in-out property <int> drag-init-idx: -1;
    in-out property <int> drag-row: -1;
    in-out property <bool> drag-active: false;
    in-out property <length> sequence-scroll-offset: 0px;
    property <length> sequence-scrollbar-thumb: max(40px, 170px * (170px / max(root.sequence-points-count * 44px + 6px, 171px)));
    property <bool> sequence-scrollbar-visible: root.sequence-points-count * 44px + 6px > 170px;
    in-out property <bool> ui-reset: false;
    ui-reset-timer := Timer {
        interval: 50ms;
        running: root.ui-reset;
        triggered() => { root.ui-reset = false; }
    }

    callback toggle-advanced-mode();
    callback move-sequence-point(int, int);
    callback delete-sequence-point(int);
    callback set-sequence-point-x(int, string);
    callback set-sequence-point-y(int, string);
    callback set-sequence-point-clicks(int, string);
    callback drag-window();
    callback close-window();
    callback minimize-window();
    callback toggle-always-on-top();
    callback request-capture-hotkey();
    callback clear-hotkey();
    callback request-capture-sequence-hotkey();
    callback clear-sequence-hotkey();
    callback request-capture-key();
    callback reset-click-key();
    callback open-shortcut-settings();
    callback capture-input(string, bool, bool, bool, bool, bool) -> bool;

    forward-focus: key-focus;
    key-focus := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        capture-key-pressed(event) => {
            if (event.repeat) { reject }
            else if (event.text == Key.F1) { root.capture-input("F1", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F2) { root.capture-input("F2", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F3) { root.capture-input("F3", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F4) { root.capture-input("F4", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F5) { root.capture-input("F5", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F6) { root.capture-input("F6", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F7) { root.capture-input("F7", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F8) { root.capture-input("F8", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F9) { root.capture-input("F9", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F10) { root.capture-input("F10", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F11) { root.capture-input("F11", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.F12) { root.capture-input("F12", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.Space) { root.capture-input("Space", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.Return) { root.capture-input("Enter", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.Escape) { root.capture-input("Esc", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.Backspace) { root.capture-input("Backspace", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.Tab) { root.capture-input("Tab", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.Delete) { root.capture-input("Delete", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.Insert) { root.capture-input("Insert", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.Home) { root.capture-input("Home", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.End) { root.capture-input("End", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.PageUp) { root.capture-input("PageUp", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.PageDown) { root.capture-input("PageDown", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.UpArrow) { root.capture-input("Up", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.DownArrow) { root.capture-input("Down", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.LeftArrow) { root.capture-input("Left", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.RightArrow) { root.capture-input("Right", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else if (event.text == Key.CapsLock) { root.capture-input("CapsLock", event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta); accept }
            else { if (root.capture-input(event.text, event.repeat, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta)) { accept } else { reject } }
        }

        VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: is-dark-theme ? rgba(251, 254, 254, 0.1) : rgba(0, 0, 0, 0.18);
            background: is-dark-theme ? #0c0c0e : #e5dfe7;
            VerticalLayout { spacing: 0px;

                    Rectangle {
                    height: 40px;

                    HorizontalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 4px;

                        Rectangle { width: 8px; }

                        
if !root.ui-reset : Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 6px;
                            background: ham-btn.has-hover
                                ? root.advanced-mode
                                    ? rgba(25,194,51,0.1)
                                    : (is-dark-theme ? #262626 : #e0e0e0)
                                : transparent;
                            ham-btn := TouchArea {
                                clicked => { root.toggle-advanced-mode(); root.ui-reset = true; }
                                width: 100%;
                                height: 100%;
                            }

                            Path {
                                width: 18px;
                                height: 18px;
                                x: (parent.width - 18px) / 2;
                                y: (parent.height - 18px) / 2;
                                stroke: root.advanced-mode
                                    ? #19c233
                                    : ham-btn.has-hover
                                        ? (is-dark-theme ? rgba(251,254,254,0.9) : #000000)
                                        : (is-dark-theme ? rgba(251,254,254,0.5) : rgba(0,0,0,0.65));
                                stroke-width: 2px;
                                commands: "M 2 4 L 16 4 M 2 9 L 16 9 M 2 14 L 16 14";
                                animate stroke { duration: 150ms; }
                            }
                            animate background { duration: 150ms; }
                        }

                        
                        if !root.ui-reset : Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 6px;
                            background: pin-btn.has-hover ? (
                                root.is-always-on-top ? rgba(25,194,51,0.1) : (is-dark-theme ? #262626 : #e0e0e0)
                            ) : transparent;
                            pin-btn := TouchArea {
                                clicked => { root.toggle-always-on-top(); }
                                width: 100%;
                                height: 100%;
                            }
                            Path {
                                width: 16px;
                                height: 16px;
                                x: (parent.width - 16px) / 2;
                                y: (parent.height - 16px) / 2;
                                stroke: root.is-always-on-top ? #19c233 : (is-dark-theme ? rgba(251,254,254,0.5) : rgba(0,0,0,0.65));
                                stroke-width: 2px;
                                commands: "M 5 3 L 11 3 L 10 6 L 6 6 Z M 4 6 L 12 6 M 8 6 L 8 15";
                            }
                            animate background { duration: 150ms; }
                        }

                        Rectangle { width: 8px; }

                        Rectangle {
                            horizontal-stretch: 1;
                            if !root.ui-reset : touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                        root.drag-window();
                                        root.ui-reset = true;
                                    }
                                }
                            }
                        }

                        Rectangle { width: 8px; }

                        if !root.ui-reset : Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 6px;
                            background: min-btn.has-hover ? (is-dark-theme ? #262626 : #e0e0e0) : transparent;
                            min-btn := TouchArea {
                                clicked => { root.minimize-window(); }
                                width: 100%;
                                height: 100%;
                            }
                            Rectangle {
                                width: 10px;
                                height: 2px;
                                border-radius: 1px;
                                background: min-btn.has-hover ? (is-dark-theme ? rgba(251,254,254,0.9) : #000000) : (is-dark-theme ? rgba(251,254,254,0.5) : rgba(0,0,0,0.65));
                                x: (parent.width - 10px) / 2;
                                y: (parent.height - 2px) / 2;
                            }
                            animate background { duration: 150ms; }
                        }

                        if !root.ui-reset : Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 6px;
                            background: close-btn.has-hover ? rgba(248,113,113,0.15) : transparent;
                            close-btn := TouchArea {
                                clicked => { root.close-window(); }
                                width: 100%;
                                height: 100%;
                            }
                            Path {
                                width: 10px;
                                height: 10px;
                                x: (parent.width - 10px) / 2;
                                y: (parent.height - 10px) / 2;
                                stroke: close-btn.has-hover ? rgba(255,117,107,0.75) : (is-dark-theme ? rgba(251,254,254,0.5) : rgba(0,0,0,0.65));
                                stroke-width: 2px;
                                commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
                            }
                            animate background { duration: 150ms; }
                        }

                        Rectangle { width: 8px; }
                    }

                    Text {
                        text: "QuietAutoClicker";
                        font-size: 13px;
                        font-weight: 800;

                        color: is-active ? #19c233 : (is-dark-theme ? rgba(251, 254, 254, 0.75) : #000000);
                        animate color {
                            duration: 100ms;
                        }
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 2px; background: is-dark-theme ? rgba(251, 254, 254, 0.1) : rgba(0, 0, 0, 0.18); }

                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;

                    if (rate-input-mode == 0) : ControlBox {
                        is-dark-theme: root.is-dark-theme;
                        horizontal-stretch: 1;
                        HorizontalLayout { spacing: 0px;
                            NumberInput {
                                center-text: true;
                                value <=> click-speed;
                                text <=> click-speed-text;
                                minimum: 1; maximum: 500;
                                unit: "";
                                is-dark-theme: root.is-dark-theme;
                                font-size: 13px;
                                font-weight: 800;
                                preferred-width: 56px;
                                min-width: 56px;
                                max-width: 56px;
                            }
                            VDivider { is-dark-theme: root.is-dark-theme; }
                            Text {
                                text: "clicks per";
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                font-size: 13px;
                                font-weight: 800;
                                color: is-dark-theme ? rgba(251,254,254,0.9) : #000000;
                                horizontal-stretch: 1;
                            }
                            VDivider { is-dark-theme: root.is-dark-theme; }
                            FlatComboBox {
                                is-dark-theme: root.is-dark-theme;
                                current-index <=> click-interval;
                                model: ["Second", "Minute", "Hour", "Day"];
                                font-size: 13px;
                                font-weight: 800;
                                horizontal-stretch: 1;
                            }
                            VDivider { is-dark-theme: root.is-dark-theme; }
                            FlatComboBox {
                                is-dark-theme: root.is-dark-theme;
                                current-index <=> rate-input-mode;
                                model: ["Rate", "Delay"];
                                font-size: 13px;
                                font-weight: 800;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    if (rate-input-mode == 1) : ControlBox {
                        is-dark-theme: root.is-dark-theme;
                        horizontal-stretch: 1;
                        HorizontalLayout { spacing: 0px;
                            HorizontalLayout { spacing: 2px;
                                NumberInput {
                                    center-text: true;
                                    value <=> duration-hours;
                                    text <=> duration-hours-text;
                                    minimum: 0; maximum: 999;
                                    unit: "h";
                                    is-dark-theme: root.is-dark-theme;
                                    font-size: 13px;
                                    font-weight: 800;
                                    preferred-width: 44px;
                                    min-width: 44px;
                                    max-width: 44px;
                                }
                                NumberInput {
                                    center-text: true;
                                    value <=> duration-minutes;
                                    text <=> duration-minutes-text;
                                    minimum: 0; maximum: 59;
                                    unit: "m";
                                    is-dark-theme: root.is-dark-theme;
                                    font-size: 13px;
                                    font-weight: 800;
                                    preferred-width: 36px;
                                    min-width: 36px;
                                    max-width: 36px;
                                }
                                NumberInput {
                                    center-text: true;
                                    value <=> duration-seconds;
                                    text <=> duration-seconds-text;
                                    minimum: 0; maximum: 59;
                                    unit: "s";
                                    is-dark-theme: root.is-dark-theme;
                                    font-size: 13px;
                                    font-weight: 800;
                                    preferred-width: 36px;
                                    min-width: 36px;
                                    max-width: 36px;
                                }
                                NumberInput {
                                    center-text: true;
                                    value <=> duration-milliseconds;
                                    text <=> duration-milliseconds-text;
                                    minimum: 0; maximum: 999;
                                    unit: "ms";
                                    is-dark-theme: root.is-dark-theme;
                                    font-size: 13px;
                                    font-weight: 800;
                                    preferred-width: 48px;
                                    min-width: 48px;
                                    max-width: 48px;
                                }
                            }
                            VDivider { is-dark-theme: root.is-dark-theme; }
                            Text {
                                text: "clicks per";
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                font-size: 13px;
                                font-weight: 800;
                                color: is-dark-theme ? rgba(251,254,254,0.9) : #000000;
                                horizontal-stretch: 1;
                            }
                            VDivider { is-dark-theme: root.is-dark-theme; }
                            FlatComboBox {
                                is-dark-theme: root.is-dark-theme;
                                current-index <=> rate-input-mode;
                                model: ["Rate", "Delay"];
                                font-size: 13px;
                                font-weight: 800;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    ControlBox {
                        is-dark-theme: root.is-dark-theme;
                        horizontal-stretch: 1;
                        Rectangle {
                            width: 130px;
                            height: 30px;
                            background: transparent;
                            HorizontalLayout {
                                Rectangle { horizontal-stretch: 1; background: transparent;
                                    Text {
                                        text: is-capturing-hotkey ? "Press..." : (hotkey == "" ? "None" : hotkey);
                                        font-size: 13px;
                                        font-weight: 800;
                                        color: is-dark-theme ? rgba(251,254,254,0.9) : #000000;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                    hk_touch := TouchArea {
                                        enabled: root.hotkey-editable;
                                        clicked => { root.request-capture-hotkey(); }
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                                if root.hotkey-editable && hotkey != "F6" : Rectangle {
                                    // X clears a custom (non-default) bind
                                    width: 20px;
                                    border-radius: 6px;
                                    background: clear-btn.has-hover ? rgba(255,117,107,0.15) : transparent;
                                    clear-btn := TouchArea {
                                        clicked => { root.clear-hotkey(); }
                                        width: 100%;
                                        height: 100%;
                                    }
                                    Path {
                                        width: 12px;
                                        height: 12px;
                                        x: (parent.width - 12px) / 2;
                                        y: (parent.height - 12px) / 2;
                                        stroke: clear-btn.has-hover ? rgba(255,117,107,0.75) : (is-dark-theme ? rgba(251,254,254,0.7) : rgba(0,0,0,0.6));
                                        stroke-width: 2px;
                                        commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                                    }
                                }
                                if !root.hotkey-editable : Rectangle {
                                    // Linux: binds live in KDE System Settings — pencil opens that page
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 6px;
                                    background: edit-btn.has-hover ? (is-dark-theme ? #262626 : #e2e2e2) : transparent;
                                    edit-btn := TouchArea {
                                        clicked => { root.open-shortcut-settings(); }
                                        width: 100%;
                                        height: 100%;
                                    }
                                    Path {
                                        width: 14px;
                                        height: 14px;
                                        x: (parent.width - 14px) / 2;
                                        y: (parent.height - 14px) / 2;
                                        stroke: edit-btn.has-hover
                                            ? (is-dark-theme ? rgba(251,254,254,0.95) : rgba(0,0,0,0.85))
                                            : (is-dark-theme ? rgba(251,254,254,0.75) : rgba(0,0,0,0.65));
                                        stroke-width: 1.8px;
                                        commands: "M 2 12 L 11.5 2.5 L 13.5 4.5 L 4 14 L 1 15 Z M 9.5 4.5 L 11.5 6.5";
                                    }
                                }
                            }
                        }
                        VDivider { is-dark-theme: root.is-dark-theme; }
                        FlatComboBox {
                            is-dark-theme: root.is-dark-theme;
                            current-index <=> activation-mode;
                            model: ["Toggle", "Hold"];
                            font-size: 13px;
                            font-weight: 800;
                            horizontal-stretch: 1;
                        }
                        VDivider { is-dark-theme: root.is-dark-theme; }
                        FlatComboBox {
                            is-dark-theme: root.is-dark-theme;
                            current-index <=> input-type;
                            model: ["Mouse", "Key"];
                            font-size: 13px;
                            font-weight: 800;
                            horizontal-stretch: 1;
                        }
                        VDivider { is-dark-theme: root.is-dark-theme; }
                        if input-type == 0 : FlatComboBox {
                            is-dark-theme: root.is-dark-theme;
                            current-index <=> mouse-button;
                            model: ["Left", "Right", "Middle"];
                            font-size: 13px;
                            font-weight: 800;
                            horizontal-stretch: 1;
                        }
                        if input-type == 1 : Rectangle {
                            // Captures a physical key or a modifier combo (Shift+J);
                            // a text field couldn't represent non-printable keys.
                            height: 30px;
                            background: transparent;
                            clip: true;
                            HorizontalLayout {
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                    Text {
                                        text: capturing-click-key ? "Press..." : (click-key == "" ? "Key" : click-key);
                                        font-size: 13px;
                                        font-weight: 800;
                                        color: is-dark-theme ? rgba(251,254,254,0.9) : #000000;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                        width: 100%;
                                        height: 100%;
                                    }
                                    key_ta := TouchArea {
                                        clicked => { root.request-capture-key(); }
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                                if click-key != "A" : Rectangle {
                                    width: 20px;
                                    border-radius: 6px;
                                    background: keyclr.has-hover ? rgba(255,117,107,0.15) : transparent;
                                    keyclr := TouchArea {
                                        clicked => {
                                            root.click-key = "A";
                                            root.capturing-click-key = false;
                                            root.reset-click-key();
                                        }
                                        width: 100%;
                                        height: 100%;
                                    }
                                    Path {
                                        width: 12px;
                                        height: 12px;
                                        x: (parent.width - 12px) / 2;
                                        y: (parent.height - 12px) / 2;
                                        stroke: keyclr.has-hover ? rgba(255,117,107,0.75) : (is-dark-theme ? rgba(251,254,254,0.7) : rgba(0,0,0,0.6));
                                        stroke-width: 2px;
                                        commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                                    }
                                }
                            }
                        }
                    }

                    ControlBox {
                        is-dark-theme: root.is-dark-theme;
                        horizontal-stretch: 1;
                        Rectangle { horizontal-stretch: 1; background: transparent;
                            HorizontalLayout { spacing: 4px;
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                BrandCheckBox { checked <=> random-enabled; is-dark-theme: root.is-dark-theme; }
                                Text { text: "R:"; vertical-alignment: center; font-size: 13px; font-weight: 800; color: random-enabled ? (is-dark-theme ? rgba(251,254,254,0.9) : #000000) : (is-dark-theme ? rgba(251,254,254,0.4) : rgba(0,0,0,0.35)); }
                                NumberInput {
                                    center-text: true;
                                    value <=> random-variation;
                                    text <=> random-variation-text;
                                    minimum: 0; maximum: 200;
                                    unit: "%";
                                    is-dark-theme: root.is-dark-theme;
                                    font-size: 13px;
                                    font-weight: 800;
                                    enabled: random-enabled;
                                    preferred-width: 52px;
                                    min-width: 52px;
                                    max-width: 52px;
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                        VDivider { is-dark-theme: root.is-dark-theme; }
                        Rectangle { horizontal-stretch: 1; background: transparent;
                            HorizontalLayout { spacing: 4px;
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                BrandCheckBox { checked <=> limit-time-enabled; is-dark-theme: root.is-dark-theme; }
                                Text { text: "T:"; vertical-alignment: center; font-size: 13px; font-weight: 800; color: limit-time-enabled ? (is-dark-theme ? rgba(251,254,254,0.9) : #000000) : (is-dark-theme ? rgba(251,254,254,0.4) : rgba(0,0,0,0.35)); }
                                NumberInput {
                                    center-text: true;
                                    value <=> limit-time-sec;
                                    text <=> limit-time-sec-text;
                                    minimum: 1; maximum: 86400;
                                    unit: "sec";
                                    is-dark-theme: root.is-dark-theme;
                                    font-size: 13px;
                                    font-weight: 800;
                                    enabled: limit-time-enabled;
                                    preferred-width: 66px;
                                    min-width: 66px;
                                    max-width: 66px;
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                        VDivider { is-dark-theme: root.is-dark-theme; }
                        Rectangle { horizontal-stretch: 1; background: transparent;
                            HorizontalLayout { spacing: 4px;
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                BrandCheckBox { checked <=> double-click; is-dark-theme: root.is-dark-theme; }
                                Text { text: "Double"; vertical-alignment: center; font-size: 13px; font-weight: 800; color: double-click ? (is-dark-theme ? rgba(251,254,254,0.9) : #000000) : (is-dark-theme ? rgba(251,254,254,0.4) : rgba(0,0,0,0.35)); }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }

                    if root.advanced-mode : Rectangle {
                        // Sequence Clicking is mouse-only
                        opacity: input-type == 1 ? 0.45 : 1.0;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18);
                        background: is-dark-theme ? #1a1a1a : #ffffff;
                        VerticalLayout { padding: 0px; spacing: 0px;
                            VerticalLayout { padding: 8px; spacing: 6px;
                                HorizontalLayout { spacing: 6px;
                                    Text {
                                        text: "Sequence Clicking";
                                        font-size: 13px;
                                        font-weight: 800;
                                        color: is-dark-theme ? rgba(251,254,254,0.9) : #000000;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: 130px;
                                        height: 30px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: is-dark-theme ? rgba(251,254,254,0.12) : rgba(0,0,0,0.22);
                                        background: transparent;
                                        seq-chip := TouchArea {
                                            enabled: root.sequence-hotkey-editable && input-type == 0;
                                            clicked => { root.request-capture-sequence-hotkey(); }
                                            width: 100%;
                                            height: 100%;
                                        }
                                        HorizontalLayout { spacing: 2px;
                                            Text {
                                                text: root.is-capturing-sequence-hotkey ? "Press..." : (root.sequence-hotkey == "" ? "None" : root.sequence-hotkey);
                                                font-size: 13px;
                                                font-weight: 800;
                                                horizontal-stretch: 1;
                                                color: is-dark-theme ? rgba(251,254,254,0.9) : #000000;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                            if root.sequence-hotkey-editable && root.sequence-hotkey != "F7" : Rectangle {
                                                width: 20px;
                                                border-radius: 6px;
                                                background: seq-chip-clear.has-hover ? rgba(255,117,107,0.15) : transparent;
                                                seq-chip-clear := TouchArea {
                                                    clicked => { root.clear-sequence-hotkey(); }
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                                Path {
                                                    width: 12px;
                                                    height: 12px;
                                                    x: (parent.width - 12px) / 2;
                                                    y: (parent.height - 12px) / 2;
                                                    stroke: seq-chip-clear.has-hover ? rgba(255,117,107,0.75) : (is-dark-theme ? rgba(251,254,254,0.6) : rgba(0,0,0,0.6));
                                                    stroke-width: 2px;
                                                    commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                                                }
                                            }
                                            if !root.sequence-hotkey-editable : Rectangle {
                                                // Linux: pencil opens KDE System Settings for our binds
                                                width: 30px;
                                                height: 30px;
                                                border-radius: 6px;
                                                background: seq-edit-btn.has-hover ? (is-dark-theme ? #262626 : #e2e2e2) : transparent;
                                                seq-edit-btn := TouchArea {
                                                    enabled: input-type == 0;
                                                    clicked => { root.open-shortcut-settings(); }
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                                Path {
                                                    width: 14px;
                                                    height: 14px;
                                                    x: (parent.width - 14px) / 2;
                                                    y: (parent.height - 14px) / 2;
                                                    stroke: seq-edit-btn.has-hover
                                                        ? (is-dark-theme ? rgba(251,254,254,0.95) : rgba(0,0,0,0.85))
                                                        : (is-dark-theme ? rgba(251,254,254,0.75) : rgba(0,0,0,0.65));
                                                    stroke-width: 1.8px;
                                                    commands: "M 2 12 L 11.5 2.5 L 13.5 4.5 L 4 14 L 1 15 Z M 9.5 4.5 L 11.5 6.5";
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.show-xwayland-status : Rectangle {
                                    height: 14px;
                                    HorizontalLayout { spacing: 6px; alignment: center;
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: root.xwayland-ok
                                                ? #19c233
                                                : (is-dark-theme ? rgba(251,254,254,0.28) : rgba(0,0,0,0.25));
                                        }
                                        Text {
                                            text: root.xwayland-ok ? "Xwayland: on" : "Xwayland: off";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: root.xwayland-ok
                                                ? (is-dark-theme ? rgba(251,254,254,0.7) : rgba(0,0,0,0.75))
                                                : (is-dark-theme ? rgba(251,254,254,0.45) : rgba(0,0,0,0.42));
                                        }
                                    }
                                    status-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: default;
                                        Tooltip { text: root.xwayland-ok ? @markdown("Cursor position: available") : @markdown("Cursor position: unavailable"); }
                                    }
                                }
                                HorizontalLayout { spacing: 4px;
                                    BrandCheckBox {
                                        // Mouse-only: with Key chosen everything here is
                                        // disabled (the poll also forces sequence-enabled off)
                                        enabled: input-type == 0;
                                        checked <=> root.sequence-enabled;
                                        is-dark-theme: root.is-dark-theme;
                                    }
                                    Text {
                                        text: "Enable";
                                        font-size: 13px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                        color: root.sequence-enabled
                                            ? (is-dark-theme ? rgba(251,254,254,0.9) : #000)
                                            : (is-dark-theme ? rgba(251,254,254,0.4) : rgba(0,0,0,0.35));
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    BrandCheckBox { checked <=> root.sequence-loop; enabled: root.sequence-enabled; is-dark-theme: root.is-dark-theme; }
                                    Text {
                                        text: "Loop";
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        color: root.sequence-enabled
                                            ? (is-dark-theme ? rgba(251,254,254,0.8) : rgba(0,0,0,0.8))
                                            : (is-dark-theme ? rgba(251,254,254,0.4) : rgba(0,0,0,0.35));
                                    }
                                    BrandCheckBox { checked <=> root.sequence-smooth; enabled: root.sequence-enabled; is-dark-theme: root.is-dark-theme; }
                                    Text {
                                        text: "Smooth";
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        color: root.sequence-enabled
                                            ? (is-dark-theme ? rgba(251,254,254,0.8) : rgba(0,0,0,0.8))
                                            : (is-dark-theme ? rgba(251,254,254,0.4) : rgba(0,0,0,0.35));
                                    }
                                    NumberInput {
                                        value <=> root.sequence-smooth-ms;
                                        text <=> root.sequence-smooth-ms-text;
                                        minimum: 10; maximum: 2000;
                                        unit: "ms";
                                        is-dark-theme: root.is-dark-theme;
                                        center-text: true;
                                        font-size: 12px;
                                        font-weight: 700;
                                        enabled: root.sequence-smooth && root.sequence-enabled;
                                        preferred-width: 76px;
                                        min-width: 76px;
                                        max-width: 76px;
                                    }
                                }

                                Rectangle {
                                    clip: true;
                                    height: root.sequence-points-count > 0 ? 170px : 0px;
                                    touch-scroll := TouchArea {
                                        scroll-event(event) => {
                                            root.sequence-scroll-offset = max(0px, min(
                                                root.sequence-scroll-offset - event.delta_y,
                                                max(0px, root.sequence-points-count * 44px + 6px - 170px)
                                            ));
                                            accept
                                        }
                                        width: 100%;
                                        height: 100%;
                                    }
                                    VerticalLayout {
                                        y: -root.sequence-scroll-offset;
                                        animate y { duration: 50ms; easing: ease-out; }
                                        spacing: 6px;
                                        for idx in root.sequence-points-count : Rectangle {
                                    min-height: 38px;
                                    preferred-height: 38px;
                                    max-height: 38px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18);
                                    background: root.drag-active && root.drag-idx == idx
                                        ? (is-dark-theme ? #1e1e1e : #d8d4dc)
                                        : (is-dark-theme ? #2a2a2a : #f2f0f3);
                                    HorizontalLayout { spacing: 6px; padding: 6px;
                                        // Leading (number / drag handle)
                                        Rectangle {
                                            min-width: 28px;
                                            preferred-width: 28px;
                                            min-height: 24px;
                                            Text {
                                                text: idx + 1;
                                                opacity: root.drag-active ? (root.drag-idx == idx ? 0 : 1) : (root.sequence-enabled && da.has-hover ? 0 : 1);
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: root.sequence-enabled
                                                    ? (is-dark-theme ? rgba(251,254,254,0.5) : rgba(0,0,0,0.5))
                                                    : (is-dark-theme ? rgba(251,254,254,0.3) : rgba(0,0,0,0.25));
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                                width: 100%;
                                                height: 100%;
                                            }
                                            Path {
                                                opacity: root.drag-active ? (root.drag-idx == idx ? 1 : 0) : (root.sequence-enabled && da.has-hover ? 1 : 0);
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - 16px) / 2;
                                                y: (parent.height - 16px) / 2;
                                                stroke: is-dark-theme ? rgba(251,254,254,0.6) : rgba(0,0,0,0.6);
                                                stroke-width: 1.5px;
                                                commands: "M 2 3 L 14 3 M 2 8 L 14 8 M 2 13 L 14 13";
                                            }
                                            da := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                pointer-event(ev) => {
                                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left && root.sequence-enabled) {
                                                        root.drag-idx = idx;
                                                        root.drag-init-idx = idx;
                                                        root.drag-row = idx;
                                                        root.drag-active = true;
                                                        true
                                                    } else if (root.drag-active && ev.kind == PointerEventKind.move) {
                                                        let dy = da.mouse-y;
                                                        let row_offset = Math.floor(dy / 44px);
                                                        let target = Math.min(Math.max(root.drag-init-idx + row_offset, 0), root.sequence-points-count - 1);
                                                        if (target != root.drag-row) {
                                                            let dir = target > root.drag-row ? 1 : -1;
                                                            root.move-sequence-point(root.drag-idx, dir);
                                                            root.drag-idx = root.drag-idx + dir;
                                                            root.drag-row = target;
                                                        }
                                                        true
                                                    } else if (root.drag-active && (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel)) {
                                                        root.drag-active = false;
                                                        root.drag-idx = -1;
                                                        root.drag-init-idx = -1;
                                                        root.drag-row = -1;
                                                        true
                                                    } else { false }
                                                }
                                            }
                                        }
                                        // X coord box
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18);
                                            background: transparent;
                                            min-height: 26px;
                                            HorizontalLayout { spacing: 2px; padding-left: 6px; padding-right: 6px;
                                                Text {
                                                    text: "X";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: root.sequence-enabled
                                                        ? (is-dark-theme ? rgba(251,254,254,0.5) : rgba(0,0,0,0.5))
                                                        : (is-dark-theme ? rgba(251,254,254,0.25) : rgba(0,0,0,0.2));
                                                    vertical-alignment: center;
                                                }
                                                xi := TextInput {
                                                    text: "" + root.sequence-points-x[idx];
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: root.sequence-enabled
                                                        ? (is-dark-theme ? rgba(251,254,254,0.8) : rgba(0,0,0,0.8))
                                                        : (is-dark-theme ? rgba(251,254,254,0.35) : rgba(0,0,0,0.3));
                                                    vertical-alignment: center;
                                                    horizontal-alignment: right;
                                                    edited => { root.set-sequence-point-x(idx, xi.text); }
                                                }
                                            }
                                        }
                                        // Y coord box
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18);
                                            background: transparent;
                                            min-height: 26px;
                                            HorizontalLayout { spacing: 2px; padding-left: 6px; padding-right: 6px;
                                                Text {
                                                    text: "Y";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: root.sequence-enabled
                                                        ? (is-dark-theme ? rgba(251,254,254,0.5) : rgba(0,0,0,0.5))
                                                        : (is-dark-theme ? rgba(251,254,254,0.25) : rgba(0,0,0,0.2));
                                                    vertical-alignment: center;
                                                }
                                                yi := TextInput {
                                                    text: "" + root.sequence-points-y[idx];
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: root.sequence-enabled
                                                        ? (is-dark-theme ? rgba(251,254,254,0.8) : rgba(0,0,0,0.8))
                                                        : (is-dark-theme ? rgba(251,254,254,0.35) : rgba(0,0,0,0.3));
                                                    vertical-alignment: center;
                                                    horizontal-alignment: right;
                                                    edited => { root.set-sequence-point-y(idx, yi.text); }
                                                }
                                            }
                                        }
                                        // Clicks count box
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18);
                                            background: transparent;
                                            min-height: 26px;
                                            HorizontalLayout { spacing: 2px; padding-left: 6px; padding-right: 6px;
                                                Text {
                                                    text: "clicks";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: root.sequence-enabled
                                                        ? (is-dark-theme ? rgba(251,254,254,0.5) : rgba(0,0,0,0.5))
                                                        : (is-dark-theme ? rgba(251,254,254,0.25) : rgba(0,0,0,0.2));
                                                    vertical-alignment: center;
                                                }
                                                ci := TextInput {
                                                    text: "" + root.sequence-points-clicks[idx];
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: root.sequence-enabled
                                                        ? (is-dark-theme ? rgba(251,254,254,0.8) : rgba(0,0,0,0.8))
                                                        : (is-dark-theme ? rgba(251,254,254,0.35) : rgba(0,0,0,0.3));
                                                    vertical-alignment: center;
                                                    horizontal-alignment: right;
                                                    input-type: number;
                                                    edited => { root.set-sequence-point-clicks(idx, ci.text); }
                                                }
                                            }
                                        }
                                        // Delete button
                                        Rectangle {
                                            min-width: 28px;
                                            preferred-width: 28px;
                                            max-width: 28px;
                                            horizontal-stretch: 0;
                                            min-height: 24px;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: del-ta.has-hover ? #e24d4d : (is-dark-theme ? rgba(251,254,254,0.1) : rgba(0,0,0,0.18));
                                            background: del-ta.has-hover ? rgba(226,77,77,0.1) : transparent;
                                            Path {
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - 16px) / 2;
                                                y: (parent.height - 16px) / 2;
                                                stroke: del-ta.has-hover ? #e24d4d : (root.sequence-enabled
                                                    ? (is-dark-theme ? rgba(251,254,254,0.6) : rgba(0,0,0,0.5))
                                                    : (is-dark-theme ? rgba(251,254,254,0.3) : rgba(0,0,0,0.25)));
                                                stroke-width: 1.1px;
                                                commands: "M2.5 3.5H9.5M4.25 3.5V2.75C4.25 2.34 4.59 2 5 2H7C7.41 2 7.75 2.34 7.75 2.75V3.5M8.75 3.5V9C8.75 9.55 8.3 10 7.75 10H4.25C3.7 10 3.25 9.55 3.25 9V3.5M5 5.25V8.25M7 5.25V8.25";
                                            }
                                            del-ta := TouchArea {
                                                clicked => { root.delete-sequence-point(idx); }
                                                width: 100%;
                                                height: 100%;
                                            }
                                        }
                                    }
                                }
                                }
                                    Rectangle {
                                        width: 6px;
                                        x: parent.width - 6px;
                                        height: 170px;
                                        opacity: root.sequence-scrollbar-visible ? 1 : 0;
                                        Rectangle {
                                            width: 4px;
                                            x: 1px;
                                            border-radius: 2px;
                                            background: is-dark-theme ? rgba(251,254,254,0.2) : rgba(0,0,0,0.12);
                                            height: root.sequence-scrollbar-thumb;
                                            y: root.sequence-scrollbar-visible
                                                ? root.sequence-scroll-offset / (root.sequence-points-count * 44px + 6px - 170px) * (170px - root.sequence-scrollbar-thumb)
                                                : 0px;
                                        }
                                    }
                                }
                                if root.sequence-enabled : Rectangle {
                                    // No clip: the software renderer combines neither
                                    // border-radius nor clip:true with text (it drops it).
                                    height: 30px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: is-dark-theme ? rgba(251,254,254,0.12) : rgba(0,0,0,0.14);
                                    background: is-dark-theme ? rgba(251,254,254,0.06) : rgba(0,0,0,0.05);
                                    // Text must stretch against the fixed 30px height —
                                    // percentage sizes inside an auto-height layout collapse to 0.
                                    HorizontalLayout { width: 100%; height: 100%; padding-left: 8px; padding-right: 8px;
                                        Text {
                                            text: root.sequence-capture-hint;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: is-dark-theme ? rgba(251,254,254,0.8) : rgba(0,0,0,0.75);
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }
}
